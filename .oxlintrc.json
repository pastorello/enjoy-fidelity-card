{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-default-export": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__enjoyFakeCard", "__enjoyFakeCardWrites", "__enjoyFakeCardControl"]
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["error"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["vite.config.ts", "*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/test/setup.ts", "src/main.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/features/**/*Page.tsx", "src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/supabaseAuthService"],
                "message": "Pages reach Supabase Auth only through useAuth() (SPEC-identity-password)."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules", ".claude", "supabase/functions/*/index.ts"]
}

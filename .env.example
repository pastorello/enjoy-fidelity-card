# Copy to .env (ignored by git). Only public, browser-safe values go here.
# Local values: run `npm run db:start` and copy API_URL and PUBLISHABLE_KEY.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_key
# Never put the secret / service role key in this file: it belongs only to Edge Functions.
